{
  "name": "dsh-zh-yayan",
  "version": "1.0.0",
  "description": "Deployment-level language policy: judgment-shaped first-sentence rule (Chinese character required, no ASCII first letter), Chinese few-shot, step-aware per-request context whose tool-result variant covers the whole next step, dual metrics, and three token presets, for every dsh agent including subagents.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./tools/*": "./tools/*",
    "./locale/*": "./locale/*"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "tools",
    "locale",
    "docs",
    "README.md",
    "RELEASE-NOTES.md",
    "CHANGELOG.md",
    "VERSIONING.md",
    "LICENSE",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "test": "node tools/selftest.mjs && node --test tools/selftest.test.mjs",
    "verify": "node tools/verify-installed.mjs",
    "audit": "node tools/lang-audit.mjs",
    "measure": "node tools/measure-appends.mjs",
    "measure-tool": "node tools/measure-tool-variant.mjs --simulate"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "cordis",
    "chinese",
    "zh",
    "zh-cn",
    "zh-hans",
    "simplified-chinese",
    "mandarin",
    "reasoning",
    "thinking",
    "chain-of-thought",
    "cot",
    "internal-reasoning",
    "language",
    "language-policy",
    "output-language",
    "prompt",
    "system-prompt",
    "prompt-injection",
    "subagent",
    "agent-team",
    "multi-agent",
    "workflow",
    "background-task",
    "中文",
    "简体中文",
    "汉语",
    "思考",
    "推理",
    "思维链",
    "中文思考",
    "中文推理",
    "子智能体",
    "团队"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurZhu1992/dsh-zh-yayan.git"
  },
  "homepage": "https://github.com/ArthurZhu1992/dsh-zh-yayan#readme",
  "bugs": {
    "url": "https://github.com/ArthurZhu1992/dsh-zh-yayan/issues"
  },
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
