{
  "name": "dsh-lang-rule",
  "version": "2.0.1",
  "description": "Deployment-level language policy: Chinese-only reasoning and output for every dsh agent, with head/subagent/mid/tail anchors and a per-request context channel where the host exposes one.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./tools/*": "./tools/*",
    "./locale/*": "./locale/*"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "tools",
    "locale",
    "docs",
    "README.md",
    "RELEASE-NOTES.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "test": "node tools/selftest.mjs && node --test tools/selftest.test.mjs",
    "verify": "node tools/verify-installed.mjs",
    "audit": "node tools/lang-audit.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "language-policy",
    "chinese",
    "reasoning",
    "lang-rule",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurZhu1992/dsh-lang-rule.git"
  },
  "homepage": "https://github.com/ArthurZhu1992/dsh-lang-rule#readme",
  "bugs": {
    "url": "https://github.com/ArthurZhu1992/dsh-lang-rule/issues"
  },
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
